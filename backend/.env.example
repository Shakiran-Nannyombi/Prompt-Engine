# GROQ API Key
GROQ_API_KEY=your_groq_api_key_here

# LangSmith API Key
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# Coach LangSmith API Key   
LANGSMITH_COACH_PROJECT="coach_agent"
COACH_LANGSMITH_API_KEY=your_coach_langsmith_api_key_here

# Refiner LangSmith API Key
REFINER_LANGSMITH_API_KEY="your_refiner_langsmith_api_key_here"
LANGSMITH_REFINER_PROJECT="refiner_agent"

# Tavily API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase Connection String
DATABASE_URL=your_supabase_postgresql_connection_string_here
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
